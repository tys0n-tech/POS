// Prisma Schema for Café POS System (PostgreSQL)
// Production-grade relational schema with indexes, cascades, and audit tracking

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------------------------
// 1. STORE & REGISTER INFRASTRUCTURE
// ---------------------------------------------------------------------------

model Store {
  id                    String      @id @default(uuid())
  name                  String      // e.g. "Northline Café"
  branchName            String      // e.g. "Siam Square Flagship"
  address               String
  phone                 String
  taxId                 String?
  vatRate               Decimal     @default(7.0) @db.Decimal(5, 2)
  vatIncluded           Boolean     @default(true)
  currencySymbol        String      @default("฿")
  receiptHeaderMessage  String?
  receiptFooterMessage  String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  registers             Register[]
  users                 User[]
  products              Product[]
  ingredients           Ingredient[]
  orders                Order[]
  shifts                Shift[]
  customers             Customer[]

  @@map("stores")
}

model Register {
  id          String    @id @default(uuid())
  storeId     String
  name        String    // e.g. "Counter 1 - Main Terminal"
  code        String    @unique // e.g. "REG-01"
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shifts      Shift[]
  orders      Order[]

  @@map("registers")
}

// ---------------------------------------------------------------------------
// 2. SHIFT & CASH DRAWER MANAGEMENT
// ---------------------------------------------------------------------------

enum ShiftStatus {
  OPEN
  CLOSED
}

model Shift {
  id            String            @id @default(uuid())
  storeId       String
  registerId    String
  openedById    String
  closedById    String?
  startTime     DateTime          @default(now())
  endTime       DateTime?
  status        ShiftStatus       @default(OPEN)
  
  startingCash  Decimal           @db.Decimal(12, 2) // Opening float
  cashSales     Decimal           @default(0) @db.Decimal(12, 2)
  digitalSales  Decimal           @default(0) @db.Decimal(12, 2)
  cashRefunds   Decimal           @default(0) @db.Decimal(12, 2)
  cashIn        Decimal           @default(0) @db.Decimal(12, 2)
  cashOut       Decimal           @default(0) @db.Decimal(12, 2)
  expectedCash  Decimal           @db.Decimal(12, 2)
  actualCash    Decimal?          @db.Decimal(12, 2)
  difference    Decimal?          @db.Decimal(12, 2) // Variance
  closingNote   String?
  
  store         Store             @relation(fields: [storeId], references: [id])
  register      Register          @relation(fields: [registerId], references: [id])
  openedBy      User              @relation("ShiftOpenedBy", fields: [openedById], references: [id])
  closedBy      User?             @relation("ShiftClosedBy", fields: [closedById], references: [id])
  cashEntries   ShiftCashEntry[]
  orders        Order[]

  @@index([storeId, status])
  @@map("shifts")
}

enum CashEntryType {
  CASH_IN
  CASH_OUT
  SALE
  REFUND
}

model ShiftCashEntry {
  id          String        @id @default(uuid())
  shiftId     String
  userId      String
  type        CashEntryType
  amount      Decimal       @db.Decimal(12, 2)
  reason      String
  createdAt   DateTime      @default(now())

  shift       Shift         @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id])

  @@map("shift_cash_entries")
}

// ---------------------------------------------------------------------------
// 3. USERS, ROLES & PERMISSIONS
// ---------------------------------------------------------------------------

enum StaffRole {
  OWNER
  MANAGER
  CASHIER
  BARISTA
}

model User {
  id              String            @id @default(uuid())
  storeId         String
  name            String
  email           String            @unique
  phone           String
  role            StaffRole         @default(CASHIER)
  pinHash         String            // Encrypted 4-6 digit PIN for quick switch
  passwordHash    String?           // For web dashboard / admin access
  avatar          String?
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  store           Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shiftsOpened    Shift[]           @relation("ShiftOpenedBy")
  shiftsClosed    Shift[]           @relation("ShiftClosedBy")
  cashEntries     ShiftCashEntry[]
  ordersHandled   Order[]
  stockTxns       InventoryTransaction[]
  auditLogs       AuditLog[]

  @@index([storeId, role])
  @@map("users")
}

// ---------------------------------------------------------------------------
// 4. MENU, PRODUCTS & MODIFIERS
// ---------------------------------------------------------------------------

model Category {
  id          String      @id @default(uuid())
  name        String      // e.g. "Coffee", "Tea", "Matcha", "Bakery"
  slug        String      @unique
  sortOrder   Int         @default(0)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  products    Product[]

  @@map("categories")
}

model Product {
  id              String                  @id @default(uuid())
  storeId         String
  categoryId      String
  name            String                  // e.g. "Iced Latte"
  description     String?
  basePrice       Decimal                 @db.Decimal(10, 2)
  costPrice       Decimal                 @default(0) @db.Decimal(10, 2)
  sku             String                  @unique // e.g. "COF-LAT-01"
  barcode         String?                 @unique // e.g. "8851001001"
  image           String?
  available       Boolean                 @default(true)
  soldCount       Int                     @default(0)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  store           Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category        Category                @relation(fields: [categoryId], references: [id])
  modifierGroups  ProductModifierGroup[]
  recipeItems     RecipeItem[]
  orderItems      OrderItem[]

  @@index([storeId, categoryId, available])
  @@map("products")
}

enum ModifierSelectionType {
  SINGLE
  MULTIPLE
}

model ModifierGroup {
  id          String                  @id @default(uuid())
  name        String                  // e.g. "SIZE", "MILK", "SWEETNESS", "ICE LEVEL", "EXTRAS"
  type        ModifierSelectionType   @default(SINGLE)
  required    Boolean                 @default(false)
  minSelect   Int                     @default(0)
  maxSelect   Int                     @default(1)
  sortOrder   Int                     @default(0)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  options     ModifierOption[]
  products    ProductModifierGroup[]

  @@map("modifier_groups")
}

model ModifierOption {
  id              String                  @id @default(uuid())
  modifierGroupId String
  name            String                  // e.g. "Oat Milk (Oatly)", "Medium (12oz)"
  priceDelta      Decimal                 @default(0) @db.Decimal(10, 2)
  isDefault       Boolean                 @default(false)
  sortOrder       Int                     @default(0)

  modifierGroup   ModifierGroup           @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  orderModifiers  OrderItemModifier[]

  @@map("modifier_options")
}

model ProductModifierGroup {
  productId       String
  modifierGroupId String

  product         Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierGroup   ModifierGroup           @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@id([productId, modifierGroupId])
  @@map("product_modifier_groups")
}

// ---------------------------------------------------------------------------
// 5. INVENTORY & RECIPE AUTO-DEDUCTION
// ---------------------------------------------------------------------------

enum UnitOfMeasure {
  G
  ML
  PCS
  KG
  L
  SHOTS
}

model Ingredient {
  id            String                  @id @default(uuid())
  storeId       String
  name          String                  // e.g. "Specialty Coffee Beans", "Fresh Whole Milk"
  currentStock  Decimal                 @db.Decimal(12, 3)
  unit          UnitOfMeasure           @default(G)
  minimumStock  Decimal                 @db.Decimal(12, 3)
  costPerUnit   Decimal                 @default(0) @db.Decimal(10, 4)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  store         Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  recipeItems   RecipeItem[]
  transactions  InventoryTransaction[]

  @@index([storeId, name])
  @@map("ingredients")
}

model RecipeItem {
  id            String        @id @default(uuid())
  productId     String
  ingredientId  String
  quantity      Decimal       @db.Decimal(10, 3) // e.g. 18.000 for 18g espresso

  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient    Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([productId, ingredientId])
  @@map("recipe_items")
}

enum InventoryTxnType {
  PURCHASE
  USAGE
  ADJUSTMENT
  WASTE
}

model InventoryTransaction {
  id              String            @id @default(uuid())
  ingredientId    String
  userId          String
  orderId         String?
  type            InventoryTxnType
  quantityChange  Decimal           @db.Decimal(12, 3) // Positive (+) or Negative (-)
  quantityAfter   Decimal           @db.Decimal(12, 3)
  reason          String            // e.g. "Auto deduction for order #1024"
  createdAt       DateTime          @default(now())

  ingredient      Ingredient        @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  user            User              @relation(fields: [userId], references: [id])
  order           Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([ingredientId, createdAt])
  @@map("inventory_transactions")
}

// ---------------------------------------------------------------------------
// 6. CUSTOMER & LOYALTY CRM
// ---------------------------------------------------------------------------

model Customer {
  id              String      @id @default(uuid())
  storeId         String
  name            String
  phone           String      @unique
  email           String?
  loyaltyPoints   Int         @default(0)
  totalOrders     Int         @default(0)
  totalSpent      Decimal     @default(0) @db.Decimal(12, 2)
  favoriteProduct String?
  notes           String?
  lastVisit       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  store           Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders          Order[]

  @@index([storeId, phone])
  @@map("customers")
}

// ---------------------------------------------------------------------------
// 7. ORDERS, ORDER ITEMS & MODIFIERS
// ---------------------------------------------------------------------------

enum OrderStatus {
  NEW
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  PARTIAL_REFUND
}

enum PaymentMethod {
  CASH
  PROMPTPAY
  CREDIT_CARD
  QR_CODE
}

model Order {
  id              String                  @id @default(uuid())
  storeId         String
  registerId      String
  shiftId         String
  staffId         String
  customerId      String?
  orderNumber     String                  // e.g. "#1024"
  orderType       OrderType               @default(DINE_IN)
  tableOrPager    String?
  status          OrderStatus             @default(NEW)
  paymentStatus   PaymentStatus           @default(PENDING)
  paymentMethod   PaymentMethod?
  
  subtotal        Decimal                 @db.Decimal(10, 2)
  discount        Decimal                 @default(0) @db.Decimal(10, 2)
  tax             Decimal                 @default(0) @db.Decimal(10, 2)
  total           Decimal                 @db.Decimal(10, 2)
  
  notes           String?
  refundReason    String?
  refundedAt      DateTime?
  completedAt     DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  store           Store                   @relation(fields: [storeId], references: [id])
  register        Register                @relation(fields: [registerId], references: [id])
  shift           Shift                   @relation(fields: [shiftId], references: [id])
  staff           User                    @relation(fields: [staffId], references: [id])
  customer        Customer?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  
  items           OrderItem[]
  payments        Payment[]
  receipts        Receipt[]
  inventoryTxns   InventoryTransaction[]

  @@index([storeId, status, createdAt])
  @@index([orderNumber])
  @@map("orders")
}

model OrderItem {
  id            String                @id @default(uuid())
  orderId       String
  productId     String
  productName   String
  basePrice     Decimal               @db.Decimal(10, 2)
  unitPrice     Decimal               @db.Decimal(10, 2) // basePrice + modifiers sum
  quantity      Int                   @default(1)
  notes         String?

  order         Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product               @relation(fields: [productId], references: [id])
  modifiers     OrderItemModifier[]

  @@map("order_items")
}

model OrderItemModifier {
  id              String          @id @default(uuid())
  orderItemId     String
  modifierOptionId String
  groupName       String          // e.g. "MILK"
  optionName      String          // e.g. "Oat Milk (Oatly)"
  priceDelta      Decimal         @default(0) @db.Decimal(10, 2)

  orderItem       OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierOption  ModifierOption  @relation(fields: [modifierOptionId], references: [id])

  @@map("order_item_modifiers")
}

// ---------------------------------------------------------------------------
// 8. PAYMENTS & RECEIPTS
// ---------------------------------------------------------------------------

model Payment {
  id              String          @id @default(uuid())
  orderId         String
  amount          Decimal         @db.Decimal(10, 2)
  method          PaymentMethod
  receivedAmount  Decimal?        @db.Decimal(10, 2) // Tendered cash
  changeAmount    Decimal?        @db.Decimal(10, 2) // Cash change
  status          PaymentStatus   @default(PAID)
  transactionRef  String?         // e.g. PromptPay transaction reference or EDC approval code
  createdAt       DateTime        @default(now())

  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, method])
  @@map("payments")
}

model Receipt {
  id              String      @id @default(uuid())
  orderId         String
  receiptNumber   String      @unique // e.g. "REC-20260827-1024"
  printedCount    Int         @default(1)
  lastPrintedAt   DateTime    @default(now())

  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("receipts")
}

// ---------------------------------------------------------------------------
// 9. AUDIT LOGS
// ---------------------------------------------------------------------------

model AuditLog {
  id          String      @id @default(uuid())
  userId      String
  action      String      // e.g. "REFUND_ORDER", "CLOSE_SHIFT", "PRICE_OVERRIDE"
  entityType  String      // e.g. "Order", "Shift", "Product"
  entityId    String
  payload     Json?
  ipAddress   String?
  createdAt   DateTime    @default(now())

  user        User        @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
