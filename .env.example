# ==============================================================================
# Northline Café POS - Environment Template (.env.example)
# Copy this file to .env and replace with your actual configuration values
# ==============================================================================

# Application Port & Mode
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Supabase Configuration (Frontend Realtime & Cloud Database)
# ------------------------------------------------------------------------------
# Get these values from your Supabase Project Settings -> API
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-public-key"

# ------------------------------------------------------------------------------
# Prisma Database Connection URL
# ------------------------------------------------------------------------------
# Option A: Supabase PostgreSQL (Recommended)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Option B: Local PostgreSQL Server
# DATABASE_URL="postgresql://postgres:password@localhost:5432/cafe_pos?schema=public"

# Option C: Local SQLite File (Zero config setup)
# DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
# JWT secret key for signing staff sessions
JWT_SECRET="your_jwt_secret_key_change_me_in_production"
